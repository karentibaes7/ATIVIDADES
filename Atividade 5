def ler_grafo(nome_arquivo):
    with open(nome_arquivo, "r") as arquivo:
        linhas = arquivo.readlines()

    vertices = int(linhas[0].strip())

    matriz = [[0 for _ in range(vertices)] for _ in range(vertices)]

    for linha in linhas[1:]:
        dados = linha.split()

        if len(dados) == 3:
            origem = int(dados[0])
            destino = int(dados[1])
            peso = int(dados[2])

            matriz[origem][destino] = peso
            matriz[destino][origem] = peso

    return matriz


def mostrar_matriz(matriz):
    print("\nMatriz de adjacência:")

    for linha in matriz:
        print(linha)


def vertices_adjacentes(matriz, vertice):
    adjacentes = []

    for i in range(len(matriz)):
        if matriz[vertice][i] != 0:
            adjacentes.append(i)

    return adjacentes


arquivo = "grafo.txt"

matriz = ler_grafo(arquivo)

mostrar_matriz(matriz)

vertice = int(input("\nDigite o vértice que deseja consultar: "))

adjacentes = vertices_adjacentes(matriz, vertice)

print(f"Vértices adjacentes ao vértice {vertice}:")

if adjacentes:
    print(adjacentes)
else:
    print("Esse vértice não possui vértices adjacentes.")
